{
  "info": {
    "name": "FUCinema-BR14-Manual",
    "description": "Run main collection first, retain runtime environment, stop movie-service, run this request, then restart movie-service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Manual-BR14",
      "item": [
        {
          "name": "6.15 Movie service unavailable",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{gateway}}/api/bookings",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customer2Token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"showtimeId\": \"{{showtimeId}}\",\n      \"seatCode\": \"B2\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 503\", () => pm.response.to.have.status(503));",
                  "const j = pm.response.json();",
                  "pm.test(\"Unified error body\", () => { pm.expect(pm.response.json()).to.have.all.keys(\"timestamp\", \"status\", \"error\", \"message\", \"path\"); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
